-- ==================== DRAG SYSTEM ====================
local dragging, dragInput, dragStart, startPos
FrameUtama.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = FrameUtama.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
FrameUtama.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UIS.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        FrameUtama.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==================== SERIALIZER ====================
local function DapatkanCharacter()
    return LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
end

local function SerializeData(data)
    local serialized = {}
    for _, frame in ipairs(data) do
        table.insert(serialized, {
            cf = {frame.CFrame:GetComponents()},
            vel = {frame.Velocity.X, frame.Velocity.Y, frame.Velocity.Z},
            rvel = {frame.RotVelocity.X, frame.RotVelocity.Y, frame.RotVelocity.Z},
            jump = frame.Jump
        })
    end
    return HttpService:JSONEncode(serialized)
end

local function DeserializeData(jsonStr)
    local decoded = HttpService:JSONDecode(jsonStr)
    local deserialized = {}
    for _, frame in ipairs(decoded) do
        table.insert(deserialized, {
            CFrame = CFrame.new(unpack(frame.cf)),
            Velocity = Vector3.new(unpack(frame.vel)),
            RotVelocity = Vector3.new(unpack(frame.rvel)),
            Jump = frame.jump
        })
    end
    return deserialized
end

-- ==================== FILE MANAGEMENT ====================
local MuatFilePilihan -- Forward declaration
local RefreshFileList -- Forward declaration

RefreshFileList = function()
    for _, child in ipairs(ScrollFileList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    if not listfiles then return end
    
    local files = listfiles("")
    local count = 0
    
    for _, filePath in ipairs(files) do
        if filePath:match("%.json$") then
            local fileName = filePath:match("[^/\\]+$")
            count = count + 1
            
            local TombolFile = Instance.new("TextButton")
            TombolFile.Size = UDim2.new(1, -6, 0, 24)
            TombolFile.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
            TombolFile.Text = "📁 " .. fileName
            TombolFile.Font = Enum.Font.SourceSans
            TombolFile.TextColor3 = Color3.fromRGB(220, 220, 225)
            TombolFile.TextSize = 11
            TombolFile.TextXAlignment = Enum.TextXAlignment.Left
            TombolFile.Parent = ScrollFileList
            Instance.new("UICorner", TombolFile).CornerRadius = UDim.new(0, 4)
            
            TombolFile.MouseButton1Click:Connect(function()
                CurrentFileName = fileName:gsub("%.json$", "")
                InputNama.Text = CurrentFileName
                MuatFilePilihan(fileName)
            end)
        end
    end
    
    ScrollFileList.CanvasSize = UDim2.new(0, 0, 0, count * 28)
end

MuatFilePilihan = function(fileName)
    if isfile and isfile(fileName) then
        local success, err = pcall(function()
            local json = readfile(fileName)
            RecordedFrameData = DeserializeData(json)
        end)
        if success then
            LabelStatus.Text = "Loaded: " .. #RecordedFrameData .. " Frames"
        else
            LabelStatus.Text = "Gagal memuat file!"
        end
    end
end

local function SimpanKeFile()
    if writefile and #RecordedFrameData > 0 then
        local targetFile = CurrentFileName .. ".json"
        local success, err = pcall(function()
            local json = SerializeData(RecordedFrameData)
            writefile(targetFile, json)
        end)
        if success then
            LabelStatus.Text = "Tersimpan ke " .. targetFile
            RefreshFileList()
        else
            warn("Gagal menyimpan: " .. tostring(err))
        end
    end
end

-- ==================== FUNGSI REKAM & PLAY ====================
local function MulaiMerekam()
    CurrentFileName = InputNama.Text ~= "" and InputNama.Text or "rekaman_baru"
    table.clear(RecordedFrameData)
    IsRecording = true
    TombolRecord.BackgroundColor3 = Color3.fromRGB(35, 145, 35)
    TombolRecord.Text = "🔴 MEREKAM..."
    
    RecordConnection = RunService.RenderStepped:Connect(function()
        if not IsRecording then return end
        local char = DapatkanCharacter()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if hrp and humanoid then
            table.insert(RecordedFrameData, {
                CFrame = hrp.CFrame,
                Velocity = hrp.AssemblyLinearVelocity,
                RotVelocity = hrp.AssemblyAngularVelocity,
                MoveDirection = humanoid.MoveDirection,
                Jump = humanoid.Jump
            })
            LabelStatus.Text = "Merekam... Frame: " .. #RecordedFrameData
        end
    end)
end

local function BerhentiMerekam()
    IsRecording = false
    if RecordConnection then
        RecordConnection:Disconnect()
        RecordConnection = nil
    end
    TombolRecord.BackgroundColor3 = Color3.fromRGB(110, 60, 180)
    TombolRecord.Text = "🔴 REKAM BARU"
    
    if #RecordedFrameData > 0 then
        SimpanKeFile()
    end
end

local function MulaiPlayback()
    if #RecordedFrameData == 0 then
        LabelStatus.Text = "Pilih file / rekam dulu!"
        return
    end
    
    IsPlaying = true
    TombolPlay.BackgroundColor3 = Color3.fromRGB(35, 145, 35)
    TombolPlay.Text = "▶ PLAY: ON"
    
    task.spawn(function()
        while IsPlaying do
            for index = 1, #RecordedFrameData do
                if not IsPlaying then break end
                
                local frameData = RecordedFrameData[index]
                local char = DapatkanCharacter()
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                
                if hrp and humanoid then
                    hrp.CFrame = frameData.CFrame
                    hrp.AssemblyLinearVelocity = frameData.Velocity
                    hrp.AssemblyAngularVelocity = frameData.RotVelocity
                    humanoid.Jump = frameData.Jump
                end
                
                RunService.RenderStepped:Wait()
            end
            
            if IsPlaying then
                task.wait(1)
            end
        end
    end)
end

local function BerhentiPlayback()
    IsPlaying = false
    TombolPlay.BackgroundColor3 = Color3.fromRGB(190, 35, 35)
    TombolPlay.Text = "▶ PLAY: OFF"
end

