local function switchServer(findLowest)
    local servers = {}
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    
    if req then
        local api = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=" .. (findLowest and "Asc" or "Desc") .. "&limit=100"
        local success, result = pcall(function()
            return HttpService:JSONDecode(req({Url = api}).Body)
        end)
        
        if success and result and result.data then
            for _, v in ipairs(result.data) do
                if type(v) == "table" and v.playing and v.maxPlayers and v.playing < v.maxPlayers and v.id ~= JobId then
                    table.insert(servers, v.id)
                end
            end
        end
    end

    if #servers > 0 then
        TeleportService:TeleportToPlaceInstance(PlaceId, servers[findLowest and 1 or math.random(1, #servers)], player)
    else
        TeleportService:Teleport(PlaceId, player)
    end
end

SmallServerBtn.MouseButton1Click:Connect(function()
    SmallServerBtn.Text = "Searching..."
    switchServer(true)
end)

ServerHopBtn.MouseButton1Click:Connect(function()
    ServerHopBtn.Text = "Hopping..."
    switchServer(false)
end)

