local NoClipBtn = createButton("NoClip: OFF")
NoClipBtn.Parent = Container

local NoclipLoop
local noclipEnabled = false
local originalCanCollide = {}

local function clip()
    noclipEnabled = false
    if NoclipLoop then
        NoclipLoop:Disconnect()
        NoclipLoop = nil
    end
    
    for part, status in pairs(originalCanCollide) do
        if part and part.Parent then
            part.CanCollide = status
        end
    end
    originalCanCollide = {}
end

local function noclip()
    clip()
    noclipEnabled = true
    
    local Char = player.Character
    if Char then
        for _, part in pairs(Char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCanCollide[part] = part.CanCollide
            end
        end
    end
    
    NoclipLoop = game:GetService("RunService").Stepped:Connect(function()
        if not noclipEnabled then return end
        local character = player.Character
        if character then
            for _, v in pairs(character:GetDescendants()) do
                if v:IsA("BasePart") then
                    if originalCanCollide[v] == nil then
                        originalCanCollide[v] = v.CanCollide
                    end
                    v.CanCollide = false
                end
            end
        end
    end)
end

NoClipBtn.MouseButton1Click:Connect(function()
    if noclipEnabled then
        clip()
        NoClipBtn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
        NoClipBtn.Text = "NoClip: OFF"
    else
        noclip()
        NoClipBtn.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        NoClipBtn.Text = "NoClip: ON"
    end
end)

player.CharacterAdded:Connect(function()
    clip()
end)

