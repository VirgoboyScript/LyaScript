-- ==========================================
-- 5. LOGIKA AUTO OBBY (RANDOM TOTAL TIME 105s - 107s)
-- ==========================================
local isRunning = false
local isPaused = false

local targetWaitTime = 105
local currentPhase = 1
local currentIndex = 1
local obbyStartTime = 0
local lastPauseStart = 0

local function autoObbyLoop()
    while isRunning do
        while isPaused and isRunning do
            task.wait(0.2)
        end
        if not isRunning then break end

        local character = player.Character or player.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart", 5)
        
        if not hrp then
            task.wait(1)
            continue
        end
        
        -- FASE 1: CHECKPOINT AWAL (JEDA 1.1s - 1.3s)
        if currentPhase == 1 then
            if currentIndex == 1 then
                obbyStartTime = tick()
                -- MENENTUKAN DURASI TOTAL RANDOM (105.0 - 107.0 Detik)
                targetWaitTime = math.random(1050, 1070) / 10
                statusLabel.Text = "Status: Teleport awal..."
                hrp.CFrame = CFrame.new(tpPointsPhase1[1])
                task.wait(0.5)
            end
            
            local totalPhase1 = #tpPointsPhase1
            for i = currentIndex, totalPhase1 do
                if not isRunning or isPaused then break end
                currentIndex = i
                statusLabel.Text = "Fase 1 CP: " .. i .. " / " .. totalPhase1
                
                task.wait(math.random(11, 13) / 10)
                
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = CFrame.new(tpPointsPhase1[i])
                else
                    break
                end
            end
            
            if not isRunning then break end
            if not isPaused then
                currentPhase = 2
                currentIndex = 1
            end
        end

        -- FASE 2: MENUNGGU HINGGA TOTAL WAKTU MENCAPAI TARGET RANDOM (105s - 107s)
        if currentPhase == 2 then
            local elapsedTime = tick() - obbyStartTime
            local timeLeft = targetWaitTime - elapsedTime
            
            while timeLeft > 0 and isRunning and not isPaused do
                statusLabel.Text = "Tunggu " .. math.floor(timeLeft) .. "s (Target: " .. string.format("%.1f", targetWaitTime) .. "s)"
                task.wait(1)
                elapsedTime = tick() - obbyStartTime
                timeLeft = targetWaitTime - elapsedTime
            end
            
            if not isRunning then break end
            if not isPaused then
                currentPhase = 3
                currentIndex = 1
            end
        end

        -- FASE 3: 2 TITIK AKHIR (JEDA 1.1s - 1.3s)
        if currentPhase == 3 then
            local totalPhase3 = #tpPointsPhase3
            for i = currentIndex, totalPhase3 do
                if not isRunning or isPaused then break end
                currentIndex = i
                statusLabel.Text = "Fase Akhir CP: " .. i .. " / " .. totalPhase3
                
                task.wait(math.random(11, 13) / 10)
                
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = CFrame.new(tpPointsPhase3[i])
                else
                    break
                end
            end
            
            if not isRunning then break end
            if not isPaused then
                currentPhase = 4
            end
        end

        -- FASE 4: KLIK REPLAY AUTOMATIS
        if currentPhase == 4 then
            statusLabel.Text = "Status: Cek Replay..."
            local activeReplayBtn = nil
            
            while isRunning and not isPaused do
                activeReplayBtn = getVisibleReplayButton()
                if activeReplayBtn then break end
                task.wait(0.2)
            end
            
            if not isRunning or isPaused then break end
            
            statusLabel.Text = "Status: Klik Replay..."
            while isRunning and not isPaused and activeReplayBtn and activeReplayBtn.Parent and activeReplayBtn.Parent.Visible do
                clickButton(activeReplayBtn)
                task.wait(math.random(3, 5) / 10)
            end
            
            if not isRunning or isPaused then break end
            
            statusLabel.Text = "Status: Replay Berhasil!"
            task.wait(math.random(5, 10) / 10)
            
            -- Reset untuk perulangan obby berikutnya dari awal
            currentPhase = 1
            currentIndex = 1
        end
    end
    
    if not isRunning and not isPaused then
        startBtn.Text = "Start Auto Obby"
        startBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        startBtn.BackgroundTransparency = 0.4
        startBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
        statusLabel.Text = "Status: Idle"
        currentPhase = 1
        currentIndex = 1
    end
end

