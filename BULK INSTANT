----------------------------------------------------
-- DYNAMIC RESIZING & INPUT SYSTEM
----------------------------------------------------
local inputBoxes = {}

-- Fungsi Penyesuaian Ukuran GUI Sesuai Jumlah Kolom
local function resizeGUI()
    task.wait(0.02)
    local count = #inputBoxes
    local visibleRows = math.min(count, 5) -- Maksimal 5 baris yang muncul di layar
    
    -- Hitung tinggi yang dibutuhkan: TitleBar (30) + ControlFrame (48) + Padding (16) + (Tinggi Baris (30) * jumlah baris) + Spacing (6)
    local targetHeight = 30 + 48 + 16 + (visibleRows * 30) + ((visibleRows - 1) * 6)
    
    MainFrame.Size = UDim2.new(0, 270, 0, targetHeight)
    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 12)
end

local function addInputRow()
    local index = #inputBoxes + 1
    
    local rowFrame = Instance.new("Frame")
    rowFrame.Name = "Row_" .. index
    rowFrame.Size = UDim2.new(1, -4, 0, 30)
    rowFrame.BackgroundColor3 = Color3.fromRGB(30, 41, 59)
    makeCorner(rowFrame, 6)
    
    local label = Instance.new("TextLabel")
    label.Parent = rowFrame
    label.Size = UDim2.new(0, 40, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = "ID " .. index .. ":"
    label.TextColor3 = Color3.fromRGB(148, 163, 184)
    label.TextSize = 11
    
    local textBox = Instance.new("TextBox")
    textBox.Name = "InputBox"
    textBox.Parent = rowFrame
    textBox.Position = UDim2.new(0, 40, 0, 0)
    textBox.Size = UDim2.new(1, -40, 1, 0)
    textBox.BackgroundTransparency = 1
    textBox.Font = Enum.Font.Gotham
    textBox.PlaceholderText = "Masukkan Asset ID..."
    textBox.PlaceholderColor3 = Color3.fromRGB(100, 116, 139)
    textBox.Text = ""
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.TextSize = 11
    textBox.TextXAlignment = Enum.TextXAlignment.Left
    
    rowFrame.Parent = ScrollContainer
    table.insert(inputBoxes, rowFrame)
    resizeGUI()
end

local function removeInputRow()
    if #inputBoxes > 1 then
        local lastRow = table.remove(inputBoxes, #inputBoxes)
        if lastRow then
            lastRow:Destroy()
            resizeGUI()
        end
    end
end

-- Inisialisasi awal 1 Kolom ID pas di layar
addInputRow()

AddBtn.MouseButton1Click:Connect(addInputRow)
RemoveBtn.MouseButton1Click:Connect(removeInputRow)

----------------------------------------------------
-- FIX EXACT BULKPURCHASE REMOTE PAYLOAD
----------------------------------------------------
BuyBtn.MouseButton1Click:Connect(function()
    local bulkItems = {}
    local catalogItems = {}
    
    for _, row in ipairs(inputBoxes) do
        local box = row:FindFirstChild("InputBox")
        if box and box.Text ~= "" then
            local cleanId = box.Text:gsub("%s+", "")
            
            -- Format presisi sesuai contoh kamu:
            table.insert(bulkItems, {
                Id = cleanId,
                Type = Enum.MarketplaceProductType.AvatarAsset
            })
            
            table.insert(catalogItems, {
                id = tonumber(cleanId) or cleanId,
                itemType = "Asset"
            })
        end
    end
    
    if #bulkItems > 0 then
        -- 1. Jalankan BulkPurchase utama (Tampilan Roblox Summary)
        pcall(function()
            local args = { bulkItems }
            game:GetService("ReplicatedStorage")
                :WaitForChild("Remotes")
                :WaitForChild("BulkPurchase")
                :FireServer(unpack(args))
        end)
        
        -- 2. Jalankan CatalogAvatar Request sebagai cadangan/tambahan
        pcall(function()
            local catalogRemote = game:GetService("ReplicatedStorage"):FindFirstChild("CatalogAvatar")
            if catalogRemote then
                local req = catalogRemote:FindFirstChild("Remotes") and catalogRemote.Remotes:FindFirstChild("Request")
                if req then
                    req:InvokeServer("bulkBuy", { items = catalogItems })
                end
            end
        end)
    end
end)

