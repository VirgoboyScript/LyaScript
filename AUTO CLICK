    else
        ToggleBtn.Text = "START"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 60)
    end
end)

-- SIMULASI TOUCH SCREEN (TAB HP) TANPA MENGGESER MOUSE
task.spawn(function()
    local touchId = 1001 -- ID unik untuk simulasi sentuhan
    while true do
        if isClicking and #points > 0 then
            for idx, marker in ipairs(points) do
                if not isClicking then break end
                
                local targetX = marker.AbsolutePosition.X + (marker.AbsoluteSize.X / 2)
                local targetY = marker.AbsolutePosition.Y + (marker.AbsoluteSize.Y / 2) + 36
                
                -- Mode Touch Screen (Mulai Sentuh -> Lepas Sentuh)
                VirtualInputManager:SendTouchEvent(touchId + idx, 0, targetX, targetY) -- Touch Begin
                task.wait(0.01)
                VirtualInputManager:SendTouchEvent(touchId + idx, 2, targetX, targetY) -- Touch End
                
                task.wait(clickDelay)
            end
        else
            task.wait(0.1)
        end
    end
end)
