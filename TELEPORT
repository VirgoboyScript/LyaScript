-- ==================== DRAG SYSTEM ====================
local dragging, dragInput, dragStart, startPos
FrameUtama.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = FrameUtama.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
FrameUtama.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UIS.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        FrameUtama.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==================== LOGIKA UTAMA TELEPORTASI & RESPAWN ====================
local function DapatkanRootPart()
    local Karakter = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
    if Karakter then return Karakter:FindFirstChild("HumanoidRootPart") end
    return nil
end

local function TembakEvent()
    pcall(function()
        local Communication = game:GetService("ReplicatedStorage"):FindFirstChild("Communication")
        if Communication and Communication:FindFirstChild("Events") then
            local Events = Communication.Events:GetChildren()
            local Event = Events[30]
            if Event then Event:FireServer(3) end
        end
    end)
end

local function LakukanRespawn(jedaDetik)
    if jedaDetik and jedaDetik > 0 then
        task.wait(jedaDetik)
        if LocalPlayer.Character then
            LocalPlayer.Character:BreakJoints()
        end
    end
end

local function GerakKeTarget(targetCFrame)
    local HRP = DapatkanRootPart()
    if HRP then
        HRP.Anchored = true
        HRP.CFrame = targetCFrame
        task.wait(0.1)
        HRP.Anchored = false
    end
end

-- Loop Auto Farm
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoFarmAktif and #SlotKoordinat > 0 then
            for i = 1, #SlotKoordinat do
                if not AutoFarmAktif then break end
                local slotData = SlotKoordinat[i]
                if slotData and slotData.CFrame then
                    GerakKeTarget(slotData.CFrame)
                    TembakEvent()
                    task.wait(JedaDiLokasi)
                    
                    -- Eksekusi Respawn jika diisi angka > 0
                    if slotData.RespawnTimer and slotData.RespawnTimer > 0 then
                        LakukanRespawn(slotData.RespawnTimer)
                        -- Tunggu karakter respawn kembali sebelum ke slot berikutnya
                        LocalPlayer.CharacterAdded:Wait()
                        task.wait(1)
                    end
                end
            end
        end
    end
end)

-- ==================== GENERATOR SLOT (UI PER SLOT DETIL) ====================
local function BuatSlotBaru()
    local id = #SlotKoordinat + 1
    SlotKoordinat[id] = {CFrame = nil, RespawnTimer = 0} 

    local ItemFrame = Instance.new("Frame")
    ItemFrame.Name = "SlotItem_" .. id
    ItemFrame.Size = UDim2.new(1, -6, 0, 26)
    ItemFrame.BackgroundTransparency = 1
    ItemFrame.Parent = SlotScrollContainer

    -- 1. Tombol Teleport Slot
    local TombolSlot = Instance.new("TextButton")
    TombolSlot.Size = UDim2.new(1, -100, 1, 0)
    TombolSlot.Position = UDim2.new(0, 0, 0, 0)
    TombolSlot.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    TombolSlot.Text = "Slot " .. id .. " (Kosong)"
    TombolSlot.Font = Enum.Font.SourceSans
    TombolSlot.TextColor3 = Color3.fromRGB(200, 200, 200)
    TombolSlot.TextSize = 11
    TombolSlot.Parent = ItemFrame
    Instance.new("UICorner", TombolSlot).CornerRadius = UDim.new(0, 4)

    -- 2. Tombol SET
    local TombolSet = Instance.new("TextButton")
    TombolSet.Size = UDim2.new(0, 35, 1, 0)
    TombolSet.Position = UDim2.new(1, -95, 0, 0)
    TombolSet.BackgroundColor3 = Color3.fromRGB(0, 110, 180)
    TombolSet.Text = "Set"
    TombolSet.Font = Enum.Font.SourceSansBold
    TombolSet.TextColor3 = Color3.new(1, 1, 1)
    TombolSet.TextSize = 11
    TombolSet.Parent = ItemFrame
    Instance.new("UICorner", TombolSet).CornerRadius = UDim.new(0, 4)

    -- 3. Input Text Timer Respawn (Contoh: "3s")
    local InputRespawn = Instance.new("TextBox")
    InputRespawn.Size = UDim2.new(0, 55, 1, 0)
    InputRespawn.Position = UDim2.new(1, -55, 0, 0)
    InputRespawn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    InputRespawn.Text = "0s"
    InputRespawn.PlaceholderText = "Respawn"
    InputRespawn.Font = Enum.Font.SourceSans
    InputRespawn.TextColor3 = Color3.fromRGB(255, 200, 100)
    InputRespawn.TextSize = 11
    InputRespawn.Parent = ItemFrame
    Instance.new("UICorner", InputRespawn).CornerRadius = UDim.new(0, 4)

    -- Event Mengubah Timer Respawn Per Slot
    local KoneksiTimer = InputRespawn.FocusLost:Connect(function()
        local angka = tonumber(InputRespawn.Text:match("%d+"))
        if angka then
            SlotKoordinat[id].RespawnTimer = angka
            InputRespawn.Text = angka .. "s"
        else
            SlotKoordinat[id].RespawnTimer = 0
            InputRespawn.Text = "0s"
        end
    end)

    -- Event Set Koordinat
    local KoneksiSet = TombolSet.MouseButton1Click:Connect(function()
        local HRP = DapatkanRootPart()
        if HRP then
            SlotKoordinat[id].CFrame = HRP.CFrame
            TombolSlot.BackgroundColor3 = Color3.fromRGB(35, 130, 35)
            TombolSlot.TextColor3 = Color3.new(1, 1, 1)
            TombolSlot.Text = "Slot " .. id .. " (Ready)"
        end
    end)

    -- Event Teleport Manual + Respawn Spesifik Slot
    local KoneksiSlot = TombolSlot.MouseButton1Click:Connect(function()
        if SlotKoordinat[id] and SlotKoordinat[id].CFrame then
            GerakKeTarget(SlotKoordinat[id].CFrame)
            if SlotKoordinat[id].RespawnTimer > 0 then
                LakukanRespawn(SlotKoordinat[id].RespawnTimer)
            end
        end
    end)

    SlotUIList[id] = {Container = ItemFrame, Conn1 = KoneksiSet, Conn2 = KoneksiSlot, Conn3 = KoneksiTimer}
end

local function HapusSlotTerakhir()
    local id = #SlotKoordinat
    if id <= 0 then return end 

    if SlotUIList[id] then
        SlotUIList[id].Conn1:Disconnect()
        SlotUIList[id].Conn2:Disconnect()
        SlotUIList[id].Conn3:Disconnect()
        SlotUIList[id].Container:Destroy()
        SlotUIList[id] = nil
        SlotKoordinat[id] = nil
    end
end

