-- ==================== DRAG SYSTEM ====================
local dragging, dragInput, dragStart, startPos
FrameUtama.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = FrameUtama.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
FrameUtama.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UIS.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        FrameUtama.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==================== UTILS ====================
local function DapatkanCharacter()
    return LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
end

local function JalanKeTarget(targetPosition)
    local Karakter = DapatkanCharacter()
    if not Karakter then return end
    
    local Humanoid = Karakter:FindFirstChildOfClass("Humanoid")
    local RootPart = Karakter:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not RootPart then return end

    Humanoid:MoveTo(targetPosition)

    -- Tunggu sampai karakter sampai ke lokasi atau butuh waktu terlalu lama (Timeout 15s)
    local reached = false
    local connection
    connection = Humanoid.MoveToFinished:Connect(function()
        reached = true
    end)

    local startTime = tick()
    while not reached and WalkLoopAktif do
        -- Cek jika jarak sudah sangat dekat (< 3 studs)
        if (RootPart.Position - targetPosition).Magnitude <= 3 then
            break
        end
        -- Batas waktu timeout jika karakter tersangkut
        if tick() - startTime > 15 then
            break
        end
        task.wait(0.1)
    end

    if connection then connection:Disconnect() end
end

-- ==================== FUNGSI URUTAN SLOT ====================
local function PerbaruiTeksDanUrutanSlot()
    for index, data in ipairs(SlotDataList) do
        data.Container.LayoutOrder = index
        if data.Position then
            data.TombolSlot.Text = "Slot " .. index .. " (Ready)"
            data.TombolSlot.BackgroundColor3 = Color3.fromRGB(35, 130, 35)
            data.TombolSlot.TextColor3 = Color3.new(1, 1, 1)
        else
            data.TombolSlot.Text = "Slot " .. index .. " (Kosong)"
            data.TombolSlot.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            data.TombolSlot.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end

local function BuatSlotBaru()
    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(1, -6, 0, 26)
    ItemFrame.BackgroundTransparency = 1
    ItemFrame.Parent = SlotScrollContainer

    local TombolSlot = Instance.new("TextButton")
    TombolSlot.Size = UDim2.new(1, -45, 1, 0)
    TombolSlot.Position = UDim2.new(0, 0, 0, 0)
    TombolSlot.Font = Enum.Font.SourceSans
    TombolSlot.TextSize = 11
    TombolSlot.Parent = ItemFrame
    Instance.new("UICorner", TombolSlot).CornerRadius = UDim.new(0, 4)

    local TombolSet = Instance.new("TextButton")
    TombolSet.Size = UDim2.new(0, 40, 1, 0)
    TombolSet.Position = UDim2.new(1, -40, 0, 0)
    TombolSet.BackgroundColor3 = Color3.fromRGB(0, 110, 180)
    TombolSet.Text = "Set"
    TombolSet.Font = Enum.Font.SourceSansBold
    TombolSet.TextColor3 = Color3.new(1, 1, 1)
    TombolSet.TextSize = 11
    TombolSet.Parent = ItemFrame
    Instance.new("UICorner", TombolSet).CornerRadius = UDim.new(0, 4)

    local DataSlot = {
        Position = nil,
        Container = ItemFrame,
        TombolSlot = TombolSlot,
        TombolSet = TombolSet
    }

    -- Listener Tombol SET (Simpan Posisi Karakter)
    TombolSet.MouseButton1Click:Connect(function()
        local Karakter = DapatkanCharacter()
        local RootPart = Karakter and Karakter:FindFirstChild("HumanoidRootPart")
        if RootPart then
            DataSlot.Position = RootPart.Position
            PerbaruiTeksDanUrutanSlot()
        end
    end)

    -- Listener Manual Walk ke Slot Tertentu
    TombolSlot.MouseButton1Click:Connect(function()
        if DataSlot.Position then
            task.spawn(function()
                JalanKeTarget(DataSlot.Position)
            end)
        end
    end)

    table.insert(SlotDataList, DataSlot)
    PerbaruiTeksDanUrutanSlot()
end

local function HapusSlotTerakhir()
    local jumlahSlot = #SlotDataList
    if jumlahSlot <= 0 then return end

    local DataTerakhir = SlotDataList[jumlahSlot]
    if DataTerakhir then
        DataTerakhir.Container:Destroy()
        table.remove(SlotDataList, jumlahSlot)
        PerbaruiTeksDanUrutanSlot()
    end
end

-- ==================== LOOPING AUTO WALK ====================
task.spawn(function()
    while true do
        task.wait(0.1)
        if WalkLoopAktif and #SlotDataList > 0 then
            for i = 1, #SlotDataList do
                if not WalkLoopAktif then break end
                
                local slotData = SlotDataList[i]
                if slotData and slotData.Position then
                    JalanKeTarget(slotData.Position)
                    task.wait(0.2) -- Jeda singkat sebelum lanjut ke titik berikutnya
                end
            end
        end
    end
end)

