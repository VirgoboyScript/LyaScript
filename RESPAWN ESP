CloseBtn.MouseButton1Click:Connect(function()
    isSpawnESPActive = false
    clearAllSpawnESP()
    if inputConnection then inputConnection:Disconnect() end
    ScreenGui:Destroy()
    ESPFolder:Destroy()
end)

-- Fungsi memasang ESP pada objek yang baru spawn
local function applySpawnESP(object)
    if not isSpawnESPActive or not object or not object:IsA("PVInstance") then return end

    -- Abaikan karakter sendiri
    if LocalPlayer.Character and object:IsDescendantOf(LocalPlayer.Character) then return end

    -- Tentukan Part target visual
    local targetPart = object:IsA("Model") and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)) or object
    if not targetPart or not targetPart:IsA("BasePart") then return end

    -- Abaikan komponen dasar map
    local nameLower = string.lower(targetPart.Name)
    if nameLower == "baseplate" or nameLower == "terrain" or nameLower == "workspace" then return end
    if targetPart:FindFirstChild("SpawnESP_Highlight") then return end

    local displayName = (object:IsA("Model") and object.Name ~= "Workspace") and object.Name or targetPart.Name

    -- 1. Buat Highlight (Glow Cyan / Biru Neon)
    local highlight = Instance.new("Highlight")
    highlight.Name = "SpawnESP_Highlight"
    highlight.Adornee = object
    highlight.FillColor = Color3.fromRGB(0, 230, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = targetPart

    -- 2. Buat Label Teks
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SpawnESP_Text"
    billboard.Adornee = targetPart
    billboard.Size = UDim2.new(0, 160, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = string.format("⚡ [ %s ]", displayName)
    textLabel.TextColor3 = Color3.fromRGB(120, 240, 255)
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 12
    textLabel.Parent = billboard

    -- Loop pembaruan jarak real-time & indikator aktif
    task.spawn(function()
        while isSpawnESPActive and object and object.Parent and targetPart and targetPart.Parent and billboard and billboard.Parent do
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local distance = math.floor((root.Position - targetPart.Position).Magnitude)
                textLabel.Text = string.format("⚡ [ %s ]\n[%dm]", displayName, distance)
            end
            task.wait(0.2)
        end
        if billboard then billboard:Destroy() end
        if highlight then highlight:Destroy() end
    end)
end

-- Fungsi utama pengubah status Toggle ON/OFF
local function toggleESP()
    isSpawnESPActive = not isSpawnESPActive
    ToggleBtn.BackgroundColor3 = isSpawnESPActive and Color3.fromRGB(0, 160, 210) or Color3.fromRGB(180, 50, 50)
    ToggleBtn.Text = "RESPAWN ESP: " .. (isSpawnESPActive and "ON [Z]" or "OFF [Z]")

    if not isSpawnESPActive then
        clearAllSpawnESP()
    end
end

-- Trigger Klik Tombol GUI
ToggleBtn.MouseButton1Click:Connect(toggleESP)

-- Trigger Menekan Tombol Keyboard Z
inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Pastikan tidak sedang mengetik di kolom chat/text box
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Z then
        toggleESP()
    end
end)

-- Deteksi saat ada Objek / NPC / Item / Player baru yang RESPAWN di Workspace
Workspace.ChildAdded:Connect(function(child)
    if isSpawnESPActive then
        task.wait(0.1) -- Jeda sebentar agar part ter-load sempurna
        pcall(function()
            applySpawnESP(child)
        end)
    end
end)

-- Deteksi jika ada bagian tubuh / prop yang spawn di dalam sub-folder Workspace
Workspace.DescendantAdded:Connect(function(descendant)
    if isSpawnESPActive and descendant:IsA("Model") then
        task.wait(0.1)
        pcall(function()
            applySpawnESP(descendant)
        end)
    end
end)
