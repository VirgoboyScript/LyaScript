-- 2. LOGIKA RESPAWN / SPAWN ESP
-- ==========================================

local function clearAllSpawnESP()
    for _, child in ipairs(ESPFolder:GetChildren()) do
        child:Destroy()
    end
    for _, desc in ipairs(Workspace:GetDescendants()) do
        local h = desc:FindFirstChild("SpawnESP_Highlight")
        if h then h:Destroy() end
    end
end

-- Variabel koneksi Input agar bisa dibersihkan saat GUI ditutup
